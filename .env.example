# ====== 飞书开放平台 ======
# 应用 App ID（飞书开放平台 → 应用凭证）
FEISHU_APP_ID=cli_xxx

# 应用 App Secret（飞书开放平台 → 应用凭证 → 查看）
FEISHU_APP_SECRET=your_app_secret_here

# 事件订阅 Encrypt Key（未开启加密则留空）
FEISHU_ENCRYPT_KEY=your_encrypt_key_here

# 事件订阅 Verification Token（飞书开放平台 → 事件订阅 → 查看）
FEISHU_VERIFICATION_TOKEN=your_verification_token_here

# OAuth 回调地址（部署后把 Railway 域名填进来）
FEISHU_REDIRECT_URI=https://xxx.up.railway.app/callback

# ====== DeepSeek ======
# 在 https://platform.deepseek.com/api_keys 创建，国内直接可用
DEEPSEEK_API_KEY=sk-your_key_here

# 模型（deepseek-chat / deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat
